{
    "name": "adrixan/eztvxrss",
    "description": "PHP-based EZTV Show RSS Feed Generator with advanced filtering and web UI",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Adrixan"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "ext-dom": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EztvXrss\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EztvXrss\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
